# Local development. Credentials are throwaway values that match docker-compose.yml.
# Copy to `.env` (gitignored). Never put real credentials in either file.

# Host port for the Postgres container. Override if this machine already runs a
# native PostgreSQL on 5432 — the container port stays 5432 either way.
POSTGRES_PORT=5432

DATABASE_URL="postgresql://truckerpoints:truckerpoints@localhost:5432/truckerpoints?schema=public"

# The e2e suite points here so a test run never truncates development data.
TEST_DATABASE_URL="postgresql://truckerpoints:truckerpoints@localhost:5432/truckerpoints_test?schema=public"

PORT=3000
